  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    (function() {
      const sidebar = document.getElementById('sidebar');
      const sidebarToggle = document.getElementById('sidebar-toggle');
      const sidebarToggleIcon = document.getElementById('sidebar-toggle-icon');
      const mobileMenuBtn = document.getElementById('mobile-menu-btn');
      const overlay = document.getElementById('overlay');
      const usersTbody = document.getElementById('users-tbody');
      const emptyState = document.getElementById('empty-state');

      // Mock user data for demo
      const demoUser = {
        name: 'John Doe',
        firstName: 'John',
        lastName: 'Doe',
        email: 'john@example.com',
        role: 'admin',
        initials: 'JD'
      };
      updateUserInfo(demoUser);

      sidebarToggle.addEventListener('click', function() {
        sidebar.classList.toggle('collapsed');
        sidebarToggleIcon.classList.toggle('bi-chevron-left');
        sidebarToggleIcon.classList.toggle('bi-chevron-right');
      });

      mobileMenuBtn.addEventListener('click', function() {
        sidebar.classList.add('open');
        overlay.classList.add('open');
      });

      overlay.addEventListener('click', function() {
        sidebar.classList.remove('open');
        overlay.classList.remove('open');
      });

      // Mock user data
      const mockUsers = [
        { id: 1, name: 'John Doe', email: 'john@example.com', role: 'admin', status: 'active', lastActive: '2024-12-15' },
        { id: 2, name: 'Jane Smith', email: 'jane@example.com', role: 'user', status: 'active', lastActive: '2024-12-14' },
        { id: 3, name: 'Bob Wilson', email: 'bob@example.com', role: 'moderator', status: 'pending', lastActive: '2024-12-10' },
        { id: 4, name: 'Alice Brown', email: 'alice@example.com', role: 'user', status: 'active', lastActive: '2024-12-13' },
        { id: 5, name: 'Charlie Davis', email: 'charlie@example.com', role: 'manager', status: 'inactive', lastActive: '2024-11-28' },
        { id: 6, name: 'Diana Prince', email: 'diana@example.com', role: 'user', status: 'active', lastActive: '2024-12-12' },
        { id: 7, name: 'Eve Adams', email: 'eve@example.com', role: 'admin', status: 'active', lastActive: '2024-12-15' },
        { id: 8, name: 'Frank Miller', email: 'frank@example.com', role: 'user', status: 'pending', lastActive: '2024-12-08' }
      ];
      renderUsers(mockUsers);

      function renderUsers(users) {
        if (!users || users.length === 0) { showEmptyState(); return; }
        usersTbody.innerHTML = '';
        users.forEach(u => {
          const row = document.createElement('tr');
          const name = u.name || 'Unknown';
          const initials = name.split(' ').map(n => n[0]).join('').toUpperCase().slice(0, 2);
          const status = u.status || 'active';
          const statusClass = status === 'active' ? 'success' : status === 'pending' ? 'warning' : status === 'inactive' ? 'secondary' : 'danger';
          const statusText = status.charAt(0).toUpperCase() + status.slice(1);
          const role = u.role || 'user';
          const roleClass = role === 'admin' ? 'danger' : role === 'moderator' ? 'warning' : role === 'manager' ? 'violet' : 'info';

          row.innerHTML = `
            <td>
              <div class="user-cell">
                <div class="avatar-sm">${initials}</div>
                <div class="user-cell-info">
                  <span class="user-cell-name">${name}</span>
                  <span class="user-cell-email">${u.email || '-'}</span>
                </div>
              </div>
            </td>
            <td>${u.email || '-'}</td>
            <td><span class="badge badge-${roleClass}">${role.charAt(0).toUpperCase() + role.slice(1)}</span></td>
            <td><span class="badge badge-${statusClass}">${statusText}</span></td>
            <td>${formatDate(u.lastActive)}</td>
            <td>
              <div class="d-flex gap-2">
                <button class="action-btn" title="Edit" onclick="editUser('${u.id}')"><i class="bi bi-pencil"></i></button>
                <button class="action-btn danger" title="Delete" onclick="deleteUser('${u.id}')"><i class="bi bi-trash"></i></button>
              </div>
            </td>
          `;
          usersTbody.appendChild(row);
        });
      }

      function formatDate(dateStr) {
        if (!dateStr) return '-';
        const date = new Date(dateStr);
        return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
      }

      function showEmptyState() { usersTbody.innerHTML = ''; emptyState.classList.remove('d-none'); }

      function updateUserInfo(user) {
        const name = user.name || (user.firstName + ' ' + user.lastName) || 'User';
        const firstName = user.firstName || name.split(' ')[0];
        const initials = user.initials || name.split(' ').map(n => n[0]).join('').toUpperCase().slice(0, 2);
        document.getElementById('user-name').textContent = name;
        document.getElementById('user-role').textContent = (user.role || 'user').charAt(0).toUpperCase() + (user.role || 'user').slice(1);
        document.getElementById('user-avatar').textContent = initials;
        document.getElementById('welcome-name').textContent = firstName;
      }

      window.logout = function(e) { e.preventDefault(); localStorage.clear(); };
      window.editUser = function(id) { alert('Edit user: ' + id); };
      window.deleteUser = function(id) { if (confirm('Delete this user?')) alert('Delete user: ' + id); };
    })();
  </script>
</body>
